df <- read.csv("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv")
# Question 2.a
# H0: There is no difference in the average number of new or repaired drinking
# water facilities between groups with reservation policy and those without.
# HA: there is an effect.
# Questoin 2.b
glimpse(df)
glimpse(df[df$reserved == 1, ]$reserved)
res <- df[df$reserved == 1, ]$water
length(res)
ctrl <- df[df$reserved == 0, ]$water
glimpse(ctrl)
set.seed(101)
ctrl_108 <- sample(ctrl, 108, replace = FALSE)
ctrl_108
# two-sample t-test:
mean_ctrl <- mean(ctrl)
mean_res <- mean(res)
mean_ctrl
mean_res
ate <- mean_res - mean_ctrl
ate
sd_ctrl <- sd(ctrl)
sd_res <- sd(res)
t_stat <- (mean_ctrl - mean_res)/(sqrt((sd_ctrl^2/length(ctrl))+(sd_res^2/length(res))))
t_stat
p_value <- 2*pt(t_stat, df = 122.05, lower.tail = TRUE)
p_value
t.test(ctrl, res)
y <- function(x) {
mean_ctrl + ate*x
}
y(df$reserved)
covariance <- cov(ctrl_108, res)
r <- covariance/(sd(ctrl_108)*sd(res))
r
n <- 108
t_stat <- (r*sqrt(n-2))/sqrt(1-r^2)
t_stat
p_value <- 2*pt(t_stat, n-2, lower.tail = FALSE)
p_value
cor(ctrl_108, res, method = "pearson")
# it would seem there is a very weak relationship between the policy and the creation/fixing of drinking water
# to check, let's visualize
plot(ctrl_108, res)
# further solidify this suggestion with repeated sampling
p_fun <- function(x) {
covars <- cov(x, res)
rs <- covars/(sd(x)*sd(res))
ts <- (rs*sqrt(106))/sqrt(1-rs^2)
p_values <- 2*pt(ts, n-2, lower.tail = TRUE)
return(p_values)
}
t_fun <- function(x) {
covars <- cov(x, res)
rs <- covars/(sd(x)*sd(res))
ts <- (rs*sqrt(n-2))/sqrt(1-rs^2)
return(ts)
}
set.seed(101)
ctrl_108_rep <- replicate(1000, sample(ctrl, 108, replace = FALSE))
mean(t_fun(ctrl_108_rep))
# since mean t-stat is negative, using 2X lower tail to find p
mean(p_fun(ctrl_108_rep))
cor_fun <- function(y) {
cor(y, res, method = "pearson")
}
mean(cor_fun(ctrl_108_rep))
p_fun(ctrl_108_rep)
# this confirms cannot reject null hypothesis.
plot(df[df$reserved == 1, ]$water, df[df$reserved == 0, ]$water)
plot(df$reserved, df$water)
cov(df$reserved, df$water)
cov_rw <- cov(df$reserved, df$water)
cor_rw <- cov_rw/sd(df$res)*sd(df$water)
cor_rw
cor_rw <- cov_rw/(sd(df$res)*sd(df$water))
cor_rw
t_stat_1 <- (cor_rw*sqrt(n-2))/sqrt(1-cor_rw^2)
t_stat_1
p_value_1 <- 2*pt(t_stat_1, df = 122.05, lower.tail = TRUE)
p_value_1
p_value_1 <- 2*pt(t_stat_1, df = 122.05, lower.tail = FALSE)
p_value_1
t_stat_1
p_value_1 <- 2*pt(t_stat_1, df = 122.05, lower.tail = FALSE)
p_value_1
p_fun(ctrl_108_rep)
mean(cor_fun(ctrl_108_rep))
mean(p_fun(ctrl_108_rep))
cor(df$reserved, df$water, method = "pearson")
cor_rw
n <- length(df$reserved)
n
t_stat_1 <- (cor_rw*sqrt(n-2))/sqrt(1-cor_rw^2)
t_stat_1
p_value_1 <- 2*pt(t_stat_1, df = 122.05, lower.tail = FALSE)
p_value_1
cor(df$reserved, df$water, method = "pearson")
