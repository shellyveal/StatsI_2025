df <- read.csv("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv")
# Question 2.a
# H0: There is no difference in the average number of new or repaired drinking
# water facilities between groups with reservation policy and those without.
# HA: there is an effect.
# Questoin 2.b
glimpse(df)
glimpse(df[df$reserved == 1, ]$reserved)
res <- df[df$reserved == 1, ]$water
length(res)
ctrl <- df[df$reserved == 0, ]$water
glimpse(ctrl)
set.seed(101)
ctrl_108 <- sample(ctrl, 108, replace = FALSE)
ctrl_108
n <- 108
mean_res <- mean(res)
mean_ctrl <- mean(ctrl_108)
sd_ctrl <- sd(ctrl_108)
mean_ctrl <- mean(ctrl)
sd_ctrl <- sd(ctrl)
sd_res <- sd(res)
t_stat <- (mean_ctrl - mean_res)/(sqrt((sd_ctrl/length(ctrl))+(sd_res/length(res))))
t_stat
?t.test
t.test(ctrl, res)
t_stat <- (mean_ctrl - mean_res)/(sqrt((sd_ctrl^2/length(ctrl))+(sd_res^2/length(res))))
t_stat
mean_ctrl
mean_res
?pt
pt(t_stat, 122.05)
pt(t_stat, 122.05, lower.tail = FALSE)
pt(t_stat, df = 122.05, lower.tail = FALSE)
pt(t_stat, df = 122.05, lower.tail = TRUE)
sd_ctrl
sd_res
2*pt(t_stat, df = 122.05, lower.tail = TRUE)
?pnorm
p-value = 2*pt(t_stat, df = 122.05, lower.tail = TRUE)
p_value <- 2*pt(t_stat, df = 122.05, lower.tail = TRUE)
p_value
t.test(ctrl, res)
ate <- mean_ctrl - mean_res
ate
ate <- mean_res - mean_ctrl
ate
y <- function(x) {
mean_ctrl + ate*x
}
y(df$water)
y(df$reserved)
